{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["source"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "type": { "const": "github" },
            "repository": {
              "type": "string",
              "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+$"
            }
          },
          "required": ["type", "repository"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "local" }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    }
  }
}
