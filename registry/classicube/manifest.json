{
  "name": "ClassiCube",
  "author": "AndrewPH",
  "description_short": "Custom Minecraft Classic compatible client",
  "description_long": "A sandbox block game inspired by other such sandbox block games, ClassiCube brings you back to the days of 2009 where one block game ruled them all.",
  "category": "games",
  "platforms": ["gamecube", "panasonic_q"],
  "peripherals": [
    "controller",
    "sd_gecko",
    "sd2sp2",
    "bba",
    "eth2gc"
  ],
  "license": {
    "spdx": "BSD-3-Clause",
    "url": "https://github.com/UnknownShadow200/ClassiCube/blob/master/license.txt"
  },
  "source": {
    "type": "direct_url",
    "url": "https://cdn.classicube.net/client/latest/ClassiCube-gc.dol"
  },
  "treatments": [
    {
      "treatment": "contents.move",
      "arguments": ["ClassiCube-gc.dol", "apps/classicube/default.dol"]
    },
    {
      "treatment": "registry.copy",
      "arguments": ["opening.bnr", "apps/classicube/opening.bnr"]
    }
  ]
}
