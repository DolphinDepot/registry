{
  "name": "Cube64 (Wii64)",
  "author": "emu_kidid",
  "description_short": "Nintendo 64 emulator for GameCube.",
  "description_long": "Cube64 is the Nintendo 64 emulator based on Wii64. Loads ROMs (.z64/.v64/.n64) from SD card. Three variants are shipped: 'basic' (smaller build without boxart, set as default), the standard build with boxart support, and an expansion pak variant for memory-hungry titles. Per-game saves and save states go to /wii64/saves on the SD card.",
  "category": "emulators",
  "platforms": ["gamecube", "panasonic_q"],
  "peripherals": ["controller", "sd_gecko", "sd2sp2", "bba", "eth2gc", "disc"],
  "license": {
    "spdx": "GPL-2.0-only",
    "url": "https://github.com/emukidid/Wii64/blob/master/LICENCE.TXT"
  },
  "source": {
    "type": "github_release",
    "repository": "emukidid/Wii64",
    "asset_pattern": "wii64-*.7z",
    "ignore_versions": ["HiResTest", "texturepacker_1.2", "boxart.bin"]
  },
  "treatments": [
    {
      "treatment": "archive.extract",
      "arguments": ["wii64-*.7z", "."]
    },
    {
      "treatment": "contents.move",
      "arguments": ["gamecube/cube64-glN64-basic.dol", "apps/cube64/default.dol"]
    },
    {
      "treatment": "contents.move",
      "arguments": ["gamecube/cube64-glN64.dol", "apps/cube64/cube64-glN64.dol"]
    },
    {
      "treatment": "contents.move",
      "arguments": ["gamecube/cube64-glN64-exp.dol", "apps/cube64/cube64-glN64-exp.dol"]
    },
    {
      "treatment": "contents.move",
      "arguments": ["gamecube/cube64-Rice.dol", "apps/cube64/cube64-Rice.dol"]
    },
    {
      "treatment": "contents.move",
      "arguments": ["gamecube/cube64-Rice-basic.dol", "apps/cube64/cube64-Rice-basic.dol"]
    },
    {
      "treatment": "contents.move",
      "arguments": ["gamecube/cube64-Rice-exp.dol", "apps/cube64/cube64-Rice-exp.dol"]
    },
    {
      "treatment": "contents.move",
      "arguments": ["wii64/boxart.bin", "wii64/boxart.bin"]
    },
    {
      "treatment": "contents.move",
      "arguments": ["wii64/RiceVideoLinux.ini", "wii64/RiceVideoLinux.ini"]
    },
    {
      "treatment": "registry.copy",
      "arguments": ["opening.bnr", "apps/cube64/opening.bnr"]
    }
  ]
}
