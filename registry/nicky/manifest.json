{
    "name": "Nicky Boum",
    "author": "emu_kidid",
    "description_short": "Help little Nicky save his grandfather from the evil sorceress Zoldrane in a fantastical platformer through swamps and castle.",
    "description_long": "Nicky Boum is a classic platformer game initially designed for the Amiga. The game was published by Microids in 1992 and was also ported to the Atari ST and PC EGA platforms.",
    "category": "games",
    "platforms": [
        "gamecube",
        "panasonic_q"
    ],
    "peripherals": [
        "controller",
        "sd_gecko",
        "sd2sp2",
        "mmce",
        "gcloader"
    ],
    "license": {
        "spdx": "NOASSERTION"
    },
    "source": {
        "type": "github_release",
        "repository": "emukidid/Nicky-Boum",
        "asset_pattern": "nicky-boum-*-gamecube.zip"
    },
    "external_resources": [
        {
            "type": "assets",
            "label": "Nicky Boom and Nicky 2 game assets",
            "url": "https://github.com/emukidid/Nicky-Boum/blob/main/README#L26",
            "notes": "You need the original DOS version data files, easily found by searching for \"Nicky Boom PC DOS\" or \"Nicky 2 PC DOS\"."
        }
    ],
    "treatments": [
        {
            "treatment": "archive.extract",
            "arguments": [
                "nicky-boum-*-gamecube.zip",
                "."
            ]
        },
        {
            "treatment": "contents.move",
            "arguments": [
                "apps/nicky/Nicky-Boum.dol",
                "apps/nicky/default.dol"
            ]
        },
        {
            "treatment": "registry.copy",
            "arguments": [
                "opening.bnr",
                "apps/nicky/opening.bnr"
            ]
        },
        {
            "treatment": "contents.move",
            "arguments": [
                "apps/nicky/nicky1/",
                "apps/nicky/nicky1/"
            ]
        },
        {
            "treatment": "contents.move",
            "arguments": [
                "apps/nicky/nicky2/",
                "apps/nicky/nicky2/"
            ]
        }
    ]
}
