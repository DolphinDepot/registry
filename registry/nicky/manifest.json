{
  "name": "Nicky Boum",
  "author": "emu_kidid",
  "description_short": "Nicky Boom port to GameCube",
  "description_long": "Nicky Boum is a classic platformer game initially designed for the Amiga. The game was published by Microids in 1992 and was also ported to the Atari ST and PC EGA platforms.",
  "category": "games",
  "platforms": ["gamecube", "panasonic_q"],
  "peripherals": ["controller", "sd_gecko", "sd2sp2"],
  "source": {
    "type": "github_release",
    "repository": "emukidid/Nicky-Boum",
    "asset_pattern": "nicky-boum-*-gamecube.zip"
  },
  "treatments": [
    {
      "treatment": "archive.extract",
      "arguments": ["nicky-boum-*-gamecube.zip", "."]
    },
    {
      "treatment": "contents.move",
      "arguments": ["apps/nicky/Nicky-Boum.dol", "apps/nicky/default.dol"]
    },
    {
      "treatment": "contents.move",
      "arguments": ["apps/nicky/*", "apps/nicky/"]
    }
  ]
}
