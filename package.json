{
    "name": "dolphin-depot-registry",
    "private": true,
    "scripts": {
        "lint": "tsc --noEmit",
        "lint:json": "eslint '**/*.json'",
        "format": "prettier --write 'scripts/**/*.ts' '**/*.json'",
        "format:check": "prettier --check 'scripts/**/*.ts' '**/*.json'",
        "test": "vitest run",
