        "memfs": "^4.56.10",
        "prettier": "^3.8.1",
        "tsx": "^4",
        "typescript": "^5",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "ajv": "^8",
        "ajv-formats": "^3.0.1",
        "yaml": "^2"
    }
