{
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "printWidth": 80,
    "tabWidth": 4,
    "overrides": [
        {
            "files": "*.json",
            "options": {
                "parser": "json-stringify"
            }
        }
    ]
}
